# BROWSER-VISIBLE CONFIGURATION (Only VITE_STOREFRONT_MODE is exposed to the client):
# Allowed values: 'demo' | 'connected' | 'unavailable'
# Never place secrets, tenant DB names, API keys, or upstream URLs in VITE_* variables.
VITE_STOREFRONT_MODE=demo

# SERVER-ONLY CONFIGURATION (Read exclusively by the Express Storefront BFF in server/):
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
KALP_UPSTREAM_BASE_URL=
KALP_TENANT_DB=
KALP_TENANT_ID=
KALP_SERVER_API_CREDENTIAL=
