# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_STOREFRONT_MODE: Optional client runtime mode ('demo' | 'connected' | 'unavailable').
# Defaults to 'demo' in local development and 'connected' in production builds.
VITE_STOREFRONT_MODE="demo"

# SERVER-ONLY KALP UPSTREAM CONFIGURATION (Never prefix with VITE_ or expose to browser):
# Leave blank until the official Stage B Kalp Business API contract is provisioned.
KALP_UPSTREAM_BASE_URL=""
KALP_TENANT_ID=""
KALP_SERVER_API_CREDENTIAL=""
